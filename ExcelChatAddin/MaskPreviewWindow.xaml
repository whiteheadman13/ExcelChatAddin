<Window x:Class="ExcelChatAddin.MaskPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="マスキング確認"
        Width="700"
        Height="600"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- タイトル + 凡例 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="送信内容（マスキング後）"
                       FontWeight="Bold"
                       FontSize="16"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"/>
            <Border Background="#FFFF99" BorderBrush="#CCA000" BorderThickness="1"
                    Padding="6,2" CornerRadius="2" VerticalAlignment="Center">
                <TextBlock Text="■ マスキング箇所" FontSize="12" Foreground="#CC4400"/>
            </Border>
        </StackPanel>

        <!-- 本文表示（RichTextBox でハイライト） -->
        <RichTextBox x:Name="BodyBox"
                     Grid.Row="1"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontSize="14"
                     FontFamily="Consolas, Meiryo UI, sans-serif"
                     Padding="8"/>

        <!-- ボタン -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">
            <Button Content="選択語を登録"
                    Width="120"
                    Padding="10,4"
                    Margin="0,0,8,0"
                    Click="BtnRegister_Click"/>
            <Button Content="閉じる"
                    Width="100"
                    Padding="10,4"
                    Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
